# wcsmn.com — the names the site reads. Names only: copy this to .env and
# fill in values for local development; in production they are Cloudflare
# Pages environment variables, set by infra. Uncommented names are required;
# `astro build` stops when PUBLIC_API_URL or PUBLIC_TURNSTILE_SITE_KEY is
# unset, and `astro dev` runs without them. Commented ones have a default.

# Public Google Calendar API key for the homepage calendar. Read-only, and
# read at build time and passed to the homepage's client script, so it is
# exposed in client JS — expected for a browser-side key; restrict it by
# HTTP referrer and to the Calendar API (docs/DEPLOY.md). Without it the
# calendar shows a notice and falls back to the Google embed.
GOOGLE_CALENDAR_PUBLIC_API_KEY=

# Base URL of api-kaianolevine-com, which the contact form posts to. No
# trailing slash.
PUBLIC_API_URL=

# Cloudflare Turnstile site key for the contact form.
PUBLIC_TURNSTILE_SITE_KEY=

# Set by Cloudflare Pages on every build: the commit and branch the footer's
# build stamp names. Unset locally, where the branch reads "local".
# CF_PAGES_COMMIT_SHA=
# CF_PAGES_BRANCH=
